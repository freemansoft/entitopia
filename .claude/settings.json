{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in *.md) npx --no-install prettier --write \"$f\" >&2 ;; esac; } 2>/dev/null || true",
            "statusMessage": "Formatting markdown with prettier..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "claude plugin marketplace add anthropics/claude-plugins-official --scope project",
            "timeout": 30,
            "statusMessage": "Checking required plugins are installed..."
          },
          {
            "type": "command",
            "command": "claude plugin install superpowers@claude-plugins-official --scope project",
            "timeout": 30,
            "statusMessage": "Checking required plugins are installed..."
          },
          {
            "type": "command",
            "command": "claude plugin install skill-creator@claude-plugins-official --scope project",
            "timeout": 30,
            "statusMessage": "Checking required plugins are installed..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(curl -s localhost:9200:*)",
      "Bash(curl -s http://localhost:9200:*)",
      "Bash(curl -s -m 3 localhost:9200:*)",
      "Bash(curl -s -XGET localhost:9200:*)",
      "Bash(curl -s -XGET http://localhost:9200:*)",
      "Bash(curl localhost:9200:*)",
      "Bash(curl http://localhost:9200:*)",
      "Bash(cd /Users/joefreeman/Documents/GitHub/freemansoft/entitopia:*)",
      "Bash(cd /Users/joefreeman/Documents/GitHub/freemansoft/entitopia/:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(bash dependencies.sh:*)",
      "Bash(bash /Users/joefreeman/.claude/plugins/cache/claude-plugins-official/superpowers:*)",
      "Bash(git:*)"
    ]
  }
}
